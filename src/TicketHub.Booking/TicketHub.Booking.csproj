<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TicketHub.ServiceDefaults/TicketHub.ServiceDefaults.csproj" />
    <ProjectReference Include="../TicketHub.Contracts/TicketHub.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Catalog owns the contract; Booking compiles a client from the same file. -->
    <Protobuf Include="../TicketHub.Catalog/Protos/catalog.proto" GrpcServices="Client" Link="Protos/catalog.proto" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TicketHub.Booking.Tests" />
  </ItemGroup>

</Project>
