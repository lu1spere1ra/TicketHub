{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/catalog/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/catalog" } ]
      },
      "booking": {
        "ClusterId": "booking",
        "Match": { "Path": "/booking/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/booking" } ]
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": { "catalog": { "Address": "http://catalog" } }
      },
      "booking": {
        "Destinations": { "booking": { "Address": "http://booking" } }
      }
    }
  }
}
